# /etc/network/interfaces -- configuration file for ifup(8), ifdown(8)

# The loopback interface
auto lo
iface lo inet loopback

# Wireless interfaces
auto wlan0
iface wlan0 inet dhcp
	# wl18xx is a mac80211/cfg80211 driver: drive wpa_supplicant via nl80211,
	# not the legacy Wireless Extensions path. wext caused SIOCSIWENCODEEXT
	# "Invalid argument" key-set errors and the kernel "wpa_supplicant uses
	# wireless extensions" deprecation warning. wpa_supplicant manages the
	# mode/ESSID from its config, so the old wireless-tools (iwconfig)
	# wireless_mode/wireless_essid directives are dropped.
	wpa-driver nl80211
	wpa-conf /data/etc/wpa_supplicant.conf
	# The DHCP request carries the machine's own name (option 12), so a
	# server with dynamic DNS publishes it. forgefirm-hostname sets the
	# name earlier in the boot; ifupdown runs each command through the
	# shell, so the substitution reads the name of the moment.
	udhcpc_opts -x hostname:$(hostname)

# IPv6 on the same link needs no stanza: the kernel takes the router
# advertisement (prefix routes, default route, SLAAC addresses) on its own.
# No DHCPv6 client runs. Nothing started from this file may wait on a
# server without a bound: init starts the rest of the boot, the console
# login included, only after ifup returns.
