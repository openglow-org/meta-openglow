# short-description: SD card image for the bench: the rootfs alone
# long-description:
# One ext4 root partition, written to an SD card with dd. It carries no
# bootloader: the factory U-Boot in the eMMC boot area boots it when the
# saved environment selects the SD card (ffboot sd).
part / --source rootfs --ondisk mmcblk --fstype=ext4 --label root --active --align 4096

bootloader --ptable msdos
