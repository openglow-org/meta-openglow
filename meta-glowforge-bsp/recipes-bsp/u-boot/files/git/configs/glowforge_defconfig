CONFIG_ARM=y
CONFIG_ARCH_MX6=y
CONFIG_TARGET_GLOWFORGE=y
# Environment in eMMC, matching the factory layout and /etc/fw_env.config
# (0x80000 primary + 0x82000 redundant, 8 KB each). In 2020.01 these are
# Kconfig symbols; the legacy #defines in include/configs/glowforge.h are
# dead there, and without these the built binary gets ENV_IS_NOWHERE.
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_SIZE=0x2000
CONFIG_ENV_OFFSET=0x80000
CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
CONFIG_ENV_OFFSET_REDUND=0x82000
CONFIG_SYS_TEXT_BASE=0x17800000
CONFIG_SYS_EXTRA_OPTIONS="IMX_CONFIG=board/glowforge/glowforge/glowforge.cfg,MX6DL"
# CONFIG_CMD_IMLS is not set
# CONFIG_CMD_FLASH is not set
CONFIG_DM=y
CONFIG_DM_THERMAL=y
CONFIG_NET=n
CONFIG_CMD_NET=n
CONFIG_CMD_NFS=n
CONFIG_CMD_FPGA=n
CONFIG_CMD_XIMG=n
CONFIG_CMD_IMI=n
CONFIG_CMD_IMLS=n
